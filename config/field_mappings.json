{
  "field_types": {
    "Title": {
      "stream": "textual",
      "salience_weight": "high",
      "facet_bias": null
    },
    "Abstract": {
      "stream": "textual",
      "salience_weight": "high",
      "facet_bias": null
    },
    "Description": {
      "stream": "textual",
      "salience_weight": "medium",
      "facet_bias": null
    },
    "Subject_Tags": {
      "stream": "textual",
      "salience_weight": "high",
      "facet_bias": null
    },
    "Author": {
      "stream": "structural",
      "salience_weight": "low",
      "facet_bias": null
    },
    "Publisher": {
      "stream": "structural",
      "salience_weight": "administrative",
      "facet_bias": null
    },
    "Institution": {
      "stream": "structural",
      "salience_weight": "low",
      "facet_bias": null
    },
    "File_Format": {
      "stream": "structural",
      "salience_weight": "administrative",
      "facet_bias": null
    },
    "Location_Meta": {
      "stream": "structural",
      "salience_weight": "medium",
      "facet_bias": "space",
      "expected_format": "coordinates"
    },
    "Geolocation": {
      "stream": "structural",
      "salience_weight": "medium",
      "facet_bias": "space",
      "expected_format": "coordinates"
    },
    "Temporal_Meta": {
      "stream": "structural",
      "salience_weight": "medium",
      "facet_bias": "time",
      "expected_format": "date_range"
    },
    "Timestamp": {
      "stream": "structural",
      "salience_weight": "medium",
      "facet_bias": "time",
      "expected_format": "iso_date"
    }
  },
  "parsing_rules": {
    "coordinates": {
      "pattern": "([0-9]+\\.[0-9]+)\\s*°?\\s*([NSns])\\s*,\\s*([0-9]+\\.[0-9]+)\\s*°?\\s*([EWew])",
      "output_format": "decimal_degrees"
  },
    "date_range": {
      "pattern": "([0-9]{2}/[0-9]{2}/[0-9]{4})\\s*-\\s*([0-9]{2}/[0-9]{2}/[0-9]{4})",
      "output_format": "iso_range"
    },
    "iso_date": {
      "pattern": "[0-9]{2}/[0-9]{2}/[0-9]{4}",
      "output_format": "iso_date"
    }
  },
  "unmapped_field_default": {
    "stream": "structural",
    "salience_weight": "administrative",
    "facet_bias": null
  }
}
